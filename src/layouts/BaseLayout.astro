---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SEO from '../components/SEO.astro';
import { getSite, localeLinks } from '../lib/locale';
import { absolute, canonicalPath, safeJson } from '../lib/publishing';
import identity from '../data/en/about.json';

const { title, description, image, noindex = false, locale = 'zh-CN', type='website', exactTitle=false } = Astro.props;
const site=getSite(locale);
const alternates=await localeLinks(Astro.url.pathname,locale);
const url=absolute(canonicalPath(Astro.url.pathname));
const gaId = site.analytics.ga4Id;

// 全站组织结构化数据（GEO / 知识图谱友好）
const orgSchema = {
 '@context':'https://schema.org','@type':'Organization','@id':absolute('/#organization'),
 name:'Yumingxing',alternateName:'裕明兴',url:absolute('/'),
 ...(identity.legalEnglishName ? {legalName:identity.legalEnglishName}:{}),
 address:{'@type':'PostalAddress',addressCountry:'CN',addressRegion:'Guangdong',addressLocality:'Jieyang, Rongcheng',...(identity.fullEnglishAddress?{streetAddress:identity.fullEnglishAddress}:{})},
 contactPoint:{'@type':'ContactPoint',contactType:'sales',email:site.contact.email,telephone:site.contact.phoneDisplay,availableLanguage:['zh-CN','en']}
};
const pageSchema={'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,name:title || site.seo.defaultTitle,inLanguage:locale,isPartOf:{'@id':absolute('/#website')},about:{'@id':absolute('/#organization')}};
const isDetail=/\/(products|blog)\/[^/]+\/?$/.test(Astro.url.pathname);
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:locale==='en'?'Home':'首页',item:absolute(locale==='en'?'/en/':'/')},{'@type':'ListItem',position:2,name:title || site.seo.defaultTitle,item:url}]};
const hasOwnBreadcrumb=(Astro.url.pathname.startsWith('/en/')&&!['/en/products/','/en/blog/'].includes(Astro.url.pathname)&&!Astro.url.pathname.startsWith('/en/blog/')) || /\/products\/[^/]+\/?$/.test(Astro.url.pathname);
const showBreadcrumb=!['/','/en/'].includes(Astro.url.pathname)&&!hasOwnBreadcrumb;
const websiteSchema={'@context':'https://schema.org','@type':'WebSite','@id':absolute('/#website'),url:absolute('/'),name:'Yumingxing',publisher:{'@id':absolute('/#organization')},inLanguage:['zh-CN','en']};

---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;700;900&display=swap" rel="stylesheet" />

    <SEO title={title} description={description} image={image} noindex={noindex} locale={locale} alternates={alternates} type={type} exactTitle={exactTitle} />
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

    <!-- Organization 结构化数据 -->
    <script type="application/ld+json" set:html={safeJson(orgSchema)} />

    <script type="application/ld+json" set:html={safeJson(pageSchema)} />
    {['/', '/en/'].includes(Astro.url.pathname) && <script type="application/ld+json" set:html={safeJson(websiteSchema)} />}
    {showBreadcrumb && <script type="application/ld+json" set:html={safeJson(breadcrumb)} />}
    <!-- 页面级 head 注入（Product / Article JSON-LD 等） -->
    <slot name="head" />

    <!-- Google Analytics 4：空闲时加载，避免与首屏渲染争用主线程 -->
    <script is:inline define:vars={{ gaId }}>
      (function () {
        if (!gaId) return;

        function loadAnalytics() {
          if (document.querySelector('script[data-ga4]')) return;
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

          var script = document.createElement('script');
          script.async = true;
          script.dataset.ga4 = 'true';
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
          document.head.appendChild(script);

          window.gtag('js', new Date());
          window.gtag('config', gaId);
        }

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
        } else {
          window.addEventListener('load', loadAnalytics, { once: true });
        }
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header locale={locale} switchUrl={alternates.switchUrl} />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFloat locale={locale} />

    <!-- WhatsApp 点击转化埋点：任何带 data-wa 的元素被点击都会上报 GA4 -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        const t = e.target.closest('[data-wa]');
        if (!t) return;
        if (!t.href || !t.href.startsWith('https://wa.me/')) return;
        if (typeof window.gtag === 'function') {
          window.gtag('event', document.documentElement.lang === 'en' ? 'click_whatsapp_en' : 'click_whatsapp', {
            product_name: t.getAttribute('data-wa-product') || 'general',
            action_type: 'consultation',
          });
        }
      });
      document.addEventListener('click', function(e) {
        const t=e.target.closest('[data-event]');
        if(t && typeof window.gtag==='function') window.gtag('event',t.getAttribute('data-event'),{page_path:location.pathname});
      });
    </script>

    <!-- 滚动渐入：为带 .reveal 的元素在进入视口时添加 .is-visible（纯增强，可降级） -->
    <script is:inline>
      (function () {
        var nodes = document.querySelectorAll('.reveal');
        if (!nodes.length) return;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          nodes.forEach(function (n) { n.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        nodes.forEach(function (n) { io.observe(n); });
      })();
    </script>
  </body>
</html>
