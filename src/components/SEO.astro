---
import { getSite } from '../lib/locale';
import { absolute, canonicalPath } from '../lib/publishing';
const locale = Astro.props.locale || 'zh-CN';
const site = getSite(locale);

const {
  title,
  description = site.seo.defaultDescription,
  image = site.seo.ogImage,
  noindex = false,
} = Astro.props;

// 页面标题统一加上品牌后缀；首页等可不传 title 走默认大标题
const fullTitle = title ? (Astro.props.exactTitle || title.includes('|') ? title : `${title} | ${locale === 'en' ? 'Yumingxing' : `${site.brand} 裕明兴`}`) : site.seo.defaultTitle;
const canonicalURL = absolute(canonicalPath(Astro.url.pathname));
const alternates = Astro.props.alternates;
const ogImageURL = new URL(image, Astro.site || Astro.url);
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{alternates?.alternate && <>
  <link rel="alternate" hreflang="zh-CN" href={absolute(alternates.zh)} />
  <link rel="alternate" hreflang="en" href={absolute(alternates.en)} />
  <link rel="alternate" hreflang="x-default" href={absolute(alternates.zh)} />
</>}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={Astro.props.type || 'website'} />
<meta property="og:site_name" content={site.companyName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
{alternates?.alternate && <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
