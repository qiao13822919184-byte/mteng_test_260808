---
import {getSite,labels} from '../lib/locale';
const {locale='zh-CN'}=Astro.props;
const site=getSite(locale),ui=labels(locale);

const year = new Date().getFullYear();
const waLink = `https://wa.me/${site.contact.whatsappDigits}`;

const cols = locale==='en' ? [{title:'Products',links:[{label:'Cutlery & Flatware',href:'/en/stainless-steel-cutlery/'},{label:'Kitchen Utensils',href:'/en/stainless-steel-kitchen-utensils/'},{label:'Product Catalogue',href:'/en/products/'}]},{title:'Company',links:[{label:'About',href:'/en/about/'},{label:'Factory',href:'/en/factory/'},{label:'Quality & Documents',href:'/en/quality-compliance/'},{label:'OEM/ODM',href:'/en/oem-odm-cutlery/'},{label:'Hotel & Restaurant',href:'/en/hotel-restaurant-cutlery/'},{label:'Buyer Guides',href:'/en/blog/'},{label:'Request a Quote',href:'/en/contact/'}]}] : [
  {
    title: '产品',
    links: [
      { label: '不锈钢餐具套装', href: '/products?cat=flatware-sets' },
      { label: '不锈钢厨具套装', href: '/products?cat=kitchenware-sets' },
    ],
  },
  {
    title: '公司',
    links: [
      { label: '关于我们', href: '/about' },
      { label: '博客', href: '/blog' },
      { label: '联系我们', href: '/contact' },
      { label: '所有产品', href: '/products' },
    ],
  },
];
---
<footer class="mt-24 brand-hero text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr] reveal">
    <!-- Brand -->
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="brand-gradient w-10 h-10 rounded-xl grid place-items-center shadow-[0_8px_24px_-12px_rgba(0,0,0,0.6)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3v7a2 2 0 0 0 4 0V3M8 11v10M16 3c-1.5 0-2.5 1.8-2.5 4.5S14.5 12 16 12v9" />
          </svg>
        </span>
        <span class="font-display font-extrabold text-xl">{site.logoText}</span>
      </div>
      <p class="text-white/70 text-sm leading-relaxed max-w-xs">{site.description}</p>
    </div>

    {cols.map((col) => (
      <div>
        <h3 class="font-display font-semibold text-white/90 mb-4 tracking-wide">{col.title}</h3>
        <ul class="space-y-2.5 text-sm">
          {col.links.map((l) => (
            <li><a href={l.href} class="inline-flex items-center text-white/65 hover:text-white transition-colors duration-200 hover:translate-x-0.5 will-change-transform">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Contact -->
    <div>
      <h3 class="font-display font-semibold text-white/90 mb-4 tracking-wide">{ui.contact}</h3>
      <ul class="space-y-2.5 text-sm text-white/70">
        <li class="flex items-start gap-2">
          <span class="text-steel-light">✉</span>
          <a href={`mailto:${site.contact.email}`} class="hover:text-white break-all">{site.contact.email}</a>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-steel-light"></span>
          <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="footer" class="hover:text-white">WhatsApp: {site.contact.whatsappDisplay}</a>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-steel-light"></span>
          <a href={`tel:${site.contact.phoneDisplay.replace(/[^\d+]/g, '')}`} class="hover:text-white">{ui.phone}: {site.contact.phoneDisplay}</a>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-steel-light"></span>
          <span>{ui.wechat}: {site.contact.wechat}</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-steel-light"></span>
          <span>{site.contact.addressLine}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-white/55 text-xs">
      <p>© {year} {site.companyName}. {ui.rights}</p>
      <p>{site.tagline} · {site.contact.businessHours}</p>
    </div>
  </div>
</footer>
