---
import BlogImage from './BlogImage.astro';
import ResponsiveImage from "./ResponsiveImage.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import SteelShader from '../components/ui/SteelShader.astro';
import HomeFeaturedCarousel from './HomeFeaturedCarousel.astro';
import { isPublished, safeJson, entrySlug } from '../lib/publishing';
import { prefix, getSite } from '../lib/locale';
import '../styles/home.css';
import { getCollection } from 'astro:content';
import identity from '../data/identity.json';
import homeZh from '../data/home.json';
import homeEn from '../data/en/home.json';
import homeSections from '../data/home-sections.json';
import enCategories from '../data/en/categories.json';
const {locale='zh-CN'}=Astro.props;
const en=locale==='en',site=getSite(locale),home=en?homeEn:homeZh;
const text=(zh,enText)=>en?enText:zh;
const base=prefix(locale);
const language=en?'en':'zh';
const resolveIdentity=(value: string) => value.replace(/\{(businessStartYear|companyNameEn|legalNameZh)\}/g, (_, key: keyof typeof identity) => String(identity[key]));
const intro=Object.fromEntries(Object.entries(homeSections.intro[language]).map(([key,value]) => [key,resolveIdentity(value)]));
const identityText=(value: string) => value
  .replaceAll('揭阳市裕明兴五金制品厂',identity.legalNameZh)
  .replaceAll('裕明兴五金制品厂',identity.brandZh)
  .replaceAll('Jieyang Rongcheng Yumingxing Hardware Factory',identity.companyNameEn);
import categoriesData from '../data/categories.json';
const categories = en?enCategories.categories:categoriesData.categories;

const waText = encodeURIComponent(en?'Hello Yumingxing, I would like a quotation. Page: https://www.mteng.ltd/':'您好，我想咨询裕明兴的不锈钢餐厨具产品与报价。');
const waLink = `https://wa.me/${site.contact.whatsappDigits}?text=${waText}`;

const allProducts = await getCollection(en?'productsEn':'products', isPublished);
// One shared ordering keeps both language homepages aligned; product facts remain
// in the live content collections, never copied into a separate homepage record.
const featuredProducts = homeSections.featuredProductKeys.map((key) => {
  const product = allProducts.find((p) => (p.data.translationKey || entrySlug(p)) === key);
  if (!product) throw new Error(`Homepage featured product is missing or unpublished (${locale}): ${key}`);
  return product;
});
const collectionCards = homeSections.collections.map((item) => {
  const category=categories.find((category) => category.slug===item.categorySlug);
  if (!category) throw new Error(`Homepage category is missing: ${item.categorySlug}`);
  return {...item, copy:item[language], image:category.image};
});

const posts = (await getCollection(en?'blogEn':'blog', isPublished))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: home.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const icons = {
  factory: '<path d="M3 21V9l6 4V9l6 4V5l6 4v12z"/><path d="M9 21v-4M15 21v-4"/>',
  shield: '<path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
  pencil: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/>',
};

// 工艺/数据卡（呼应 Nyra data cards），取自真实参数
const specs = en ? [{k:'Materials',v:'201 / 304 / 410 / 430',note:'Confirm the grade for each model and component',motif:'gauge'},{k:'Finishes',v:'Mirror · Brushed · Logo',note:'Discuss the available finish on your model',motif:'eq'},{k:'Programmes',v:'Wholesale · OEM/ODM',note:'Retail · Hospitality · Private label',motif:'dots'}] : [
  { k: '材质', v: '201 / 304 / 410 / 430', note: '按产品用途与目标市场匹配材质', motif: 'gauge' },
  { k: '工艺', v: '镜面 · 拉丝 · 激光', note: '自有抛光 / 冲压 / 激光打标产线', motif: 'eq' },
  { k: '合作', v: 'OEM / ODM', note: '按项目确认规格、包装与交付方案', motif: 'dots' },
];
---
<BaseLayout
  locale={locale}
  title={en?homeEn.seoTitle:undefined}
  description={en?homeEn.metaDescription:site.seo.defaultDescription}
>
  <script type="application/ld+json" slot="head" set:html={safeJson(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section id="hero-glow-host" class="brand-hero text-white relative overflow-hidden">
    <!-- 真·WebGL shader 岛屿（受控背景层，client:only 懒挂载；底层 brand-hero CSS 渐变为 SSR 兜底，底部蒙版淡出收边） -->
    <div
      class="shader-fade absolute inset-0 z-0 [mask-image:linear-gradient(to_bottom,#000_72%,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,#000_72%,transparent)]"
      aria-hidden="true"
    >
      <SteelShader />
    </div>
    <!-- 暗场蒙版：顶部（导航）+ 左侧（标题区）压暗，确保亮色流光上文字可读 -->
    <div
      class="absolute inset-0 z-[1] pointer-events-none"
      aria-hidden="true"
      style="background:linear-gradient(to bottom, rgba(5,11,20,0.5), rgba(5,11,20,0) 22%), linear-gradient(100deg, rgba(5,11,20,0.62) 0%, rgba(5,11,20,0.22) 42%, rgba(5,11,20,0) 70%);"
    ></div>
    <!-- 鼠标光晕 + 延迟拖尾层（dots 由脚本注入；位于流光之上、文字之下） -->
    <div id="hero-glow" class="hero-glow" aria-hidden="true"></div>

    <!-- 右上角脉冲光环 + 环绕文字（呼应参考图，低调点缀） -->
    <div class="hidden lg:grid place-items-center absolute top-10 right-8 xl:right-16 w-24 h-24 z-10" aria-hidden="true">
      <span class="accent-ring w-14 h-14 grid place-items-center bg-white/[0.06] text-white/90">
        <img src={identity.logo} width="44" height="24" alt="" style="width:44px;height:24px;object-fit:contain" />
      </span>
      <svg class="spin-slow absolute inset-0 w-full h-full" viewBox="0 0 100 100">
        <defs><path id="ymx-ring" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" /></defs>
        <text class="fill-white/45" style="font-size:7px;letter-spacing:1.6px;font-weight:600;">
          <textPath href="#ymx-ring" startOffset="0%">{text('批发 · 代工 · 430 · 304 · 410 · 全球出口经验 · ','WHOLESALE · OEM · CUTLERY · KITCHENWARE · ')}</textPath>
        </text>
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-24 md:pt-28 md:pb-32 relative z-10">
      <p class="animate-rise glass inline-flex items-center gap-2 text-sm font-medium text-white/90 rounded-full px-4 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber shadow-[0_0_10px_2px_rgba(244,169,60,0.6)]"></span>{home.hero.eyebrow}
      </p>
      <h1 class="animate-rise steel-text font-display font-extrabold text-4xl sm:text-5xl md:text-6xl leading-[1.06] max-w-4xl">
        {identityText(home.hero.title)}
      </h1>
      <p class="animate-rise mt-6 text-lg text-white/75 max-w-2xl leading-relaxed">
        {identityText(home.hero.subtitle)}
      </p>
      <div class="animate-rise mt-9 flex flex-wrap gap-4">
        <a href={`${base}/products/`} class="btn btn-primary px-7 py-3.5 text-base">
          {home.hero.primaryCta}
        </a>
        <a href={en?`${base}/contact/`:waLink} target={en?undefined:'_blank'} rel={en?undefined:'noopener'} data-wa={en?undefined:true} data-wa-product="hero" class="btn btn-outline px-7 py-3.5 text-base">{home.hero.secondaryCta}</a>
      </div>

      <!-- Stat strip -->
      <div class="mt-16 glass relative grid grid-cols-2 sm:grid-cols-4 rounded-2xl overflow-hidden divide-x divide-y sm:divide-y-0 divide-white/10">
        <div class="pointer-events-none absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-steel-light/55 to-transparent"></div>
        {site.highlights.map((h) => (
          <div class="group px-5 py-6 text-center sm:text-left transition-colors duration-300 hover:bg-white/[0.04]">
            <div class="font-display font-extrabold text-2xl md:text-3xl brand-gradient-text">{h.value}</div>
            <div class="text-white/65 text-sm mt-1">{h.label}</div>
          </div>
        ))}
      </div>

      <!-- Feature ticker（呼应 Nyra 底部小字带） -->
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-white/55 text-xs tracking-wide">
        <span>{text('批发','Wholesale')}</span><span class="text-white/25">····</span>
        <span>{text('代工','OEM/ODM')}</span><span class="text-white/25">····</span>
        <span>201 / 304 / 410 / 430</span><span class="text-white/25">····</span>
        <span>{text('全球出口经验','B2B SUPPLY')}</span>
      </div>
    </div>
  </section>

  <!-- Company introduction; business history is distinct from incorporation. -->
  <section id="company-introduction" class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28 ymx-intro">
    <div class="ymx-intro-grid">
      <div class="reveal">
        <p class="eyebrow mb-4">{intro.eyebrow}</p>
        <h2 class="statement text-3xl sm:text-4xl ymx-intro-heading">{intro.title}</h2>
        <p class="text-ink-soft leading-relaxed ymx-intro-lead">{intro.lead}</p>
        <p class="text-ink-muted leading-relaxed ymx-intro-body">{intro.body}</p>
        <div class="ymx-intro-actions">
          <a class="btn btn-primary px-6 py-3" href={`${base}/contact/`}>{intro.contactLabel}</a>
          <a class="btn btn-ghost px-6 py-3" href={`${base}/about/`}>{intro.aboutLabel}</a>
        </div>
      </div>
      <figure class="reveal reveal-d1 ymx-factory-photo sheen group">
        <img src={homeSections.intro.image} srcset={`${homeSections.intro.image} 960w, ${homeSections.intro.imageLarge} 1440w`} sizes="(max-width: 900px) calc(100vw - 32px), 48vw" alt={intro.imageAlt} width={homeSections.intro.imageWidth} height={homeSections.intro.imageHeight} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- Two visible collection cards retain the current CMS category images. -->
  <section id="product-collections" class="bg-sand/50 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">{text('产品系列','PRODUCT COLLECTIONS')}</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-5xl">{text('无论成套餐具，还是厨具组合，都能找到适合目标市场的产品方案。','Explore Cutlery and Kitchen Utensil Collections')}</h2>
      </div>

      <div class="ymx-collection-grid">
        {collectionCards.map((c, i) => (
          <a class={`reveal reveal-d${i+1} ymx-collection-card card-hover group`} href={`${base}/${c.path}/`}>
            <div class="ymx-collection-image sheen">
              <ResponsiveImage src={c.image} alt={c.copy.title} width="1000" height="750" loading="lazy" sizes="(max-width: 700px) calc(100vw - 32px), 48vw" />
            </div>
            <div class="ymx-collection-copy">
              <h3 class="font-display font-bold text-ink text-2xl">{c.copy.title}</h3>
              <p class="text-ink-soft leading-relaxed">{c.copy.summary}</p>
              <span class="text-ocean font-semibold ymx-collection-link">{c.copy.linkLabel}<span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Shared product identities, current catalogue data, one lightweight carousel. -->
  <HomeFeaturedCarousel products={featuredProducts} locale={locale} />

  <!-- ============ VALUE PROPS（编辑风四列） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="reveal max-w-3xl mb-12">
      <p class="eyebrow mb-4">{text('我们的优势','WHY YUMINGXING')}</p>
      <h2 class="statement text-3xl sm:text-4xl md:text-5xl">{text('一家把控全流程的源头工厂。','Define the Details Before You Order')}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-line">
      {home.valueProps.map((p, i) => (
        <div class={`reveal reveal-d${i + 1} group py-8 sm:px-6 border-b sm:border-b-0 sm:border-r border-line last:border-r-0 sm:[&:nth-child(2)]:border-r-0 lg:[&:nth-child(2)]:border-r`}>
          <span class="w-12 h-12 rounded-xl bg-steel-50 text-ocean grid place-items-center mb-5 ring-1 ring-steel-light/30 transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
          </span>
          <h3 class="font-display font-bold text-ink text-lg">{p.title}</h3>
          <p class="text-ink-muted text-sm mt-2 leading-relaxed max-w-xs">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 工艺照片 + 说明（Nyra photo + caption） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div id="factory-video-preview" data-future-facebook-video data-video-url="" class="reveal rounded-3xl overflow-hidden aspect-[4/3] ring-1 ring-line border border-line ymx-future-video">
        <div class="sheen group w-full h-full">
          <ResponsiveImage src={home.whyUs.image} alt={en?homeEn.whyUs.imageAlt:home.whyUs.title} width="1000" height="750" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
      </div>
      <div class="reveal reveal-d1">
        <p class="eyebrow mb-4">{home.whyUs.subtitle}</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-[2.6rem] md:leading-[1.18]">{home.whyUs.title}</h2>
        <ul class="mt-8 space-y-4">
          {home.whyUs.points.map((pt) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 w-6 h-6 shrink-0 rounded-full brand-gradient grid place-items-center shadow-[0_4px_12px_-4px_rgba(224,70,26,0.6)]">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg>
              </span>
              <span class="text-ink-soft leading-relaxed">{pt}</span>
            </li>
          ))}
        </ul>
        <a href={en?`${base}/contact/`:waLink} target={en?undefined:'_blank'} rel={en?undefined:'noopener'} data-wa={en?undefined:true} data-wa-product="whyus" class="btn btn-primary mt-9 px-7 py-3.5">{text('立即询价','Request a Quote')}</a>
      </div>
    </div>
  </section>

  <!-- ============ 参数 / 数据卡（Nyra data cards，深色高级感） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20 sm:pb-28">
    <div class="reveal max-w-3xl mb-12">
      <p class="eyebrow mb-4">{text('为什么是裕明兴','SPECIFY YOUR PROJECT')}</p>
      <h2 class="statement text-3xl sm:text-4xl md:text-5xl">{en ? 'Materials, Finishes and Programmes for Your Market' : <>材质、工艺、产能与出口经验，<br class="hidden sm:block" />集于一家工厂。</>}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {specs.map((s, i) => (
        <div class={`reveal reveal-d${i + 1} spec-card card-hover p-7 text-white`}>
          <div class="flex items-center justify-between">
            <span class="eyebrow eyebrow-amber">{s.k}</span>
            {s.motif === 'eq' && (
              <span class="eq-bars" aria-hidden="true">
                <i style="height:40%;animation-delay:0s"></i><i style="height:75%;animation-delay:.15s"></i><i style="height:55%;animation-delay:.3s"></i><i style="height:95%;animation-delay:.45s"></i><i style="height:65%;animation-delay:.6s"></i>
              </span>
            )}
            {s.motif === 'gauge' && (
              <svg width="34" height="34" viewBox="0 0 36 36" aria-hidden="true" class="-rotate-90">
                <circle cx="18" cy="18" r="15" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="3" />
                <circle cx="18" cy="18" r="15" fill="none" stroke="url(#sp-grad)" stroke-width="3" stroke-linecap="round" stroke-dasharray="94.2" stroke-dashoffset="14" />
                <defs><linearGradient id="sp-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6fb7c7"/><stop offset="100%" stop-color="#f4a93c"/></linearGradient></defs>
              </svg>
            )}
            {s.motif === 'dots' && (
              <span class="flex gap-1.5" aria-hidden="true">
                <i class="w-1.5 h-1.5 rounded-full bg-steel-light"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-amber"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-orange"></i>
              </span>
            )}
          </div>
          <div class="font-display font-extrabold text-4xl mt-6 tracking-tight">{s.v}</div>
          <p class="text-white/60 text-sm mt-3 leading-relaxed">{s.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 合作流程（真实序列，编号成立） ============ -->
  <section class="bg-sand/50 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal max-w-3xl mb-12">
        <p class="eyebrow mb-4">{text('合作流程','HOW TO BUY')}</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-5xl">{text('从询价到交付，四步搞定。','From Sourcing Brief to Shipment')}</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {home.process.map((s, i) => (
          <div class={`reveal reveal-d${i + 1} card-hover relative bg-white rounded-2xl border border-line p-6 overflow-hidden`}>
            <span class="font-display font-extrabold text-5xl brand-gradient-text">{s.step}</span>
            <h3 class="font-display font-bold text-ink text-lg mt-3">{s.title}</h3>
            <p class="text-ink-muted text-sm mt-2 leading-relaxed">{s.desc}</p>
            <span class="pointer-events-none absolute -bottom-6 -right-4 font-display font-black text-8xl text-line/40 select-none">{s.step}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LATEST BLOG ============ -->
  {posts.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal flex flex-wrap items-end justify-between gap-4 mb-12">
        <div class="max-w-2xl">
          <p class="eyebrow mb-4">{text('采购知识','BUYER GUIDES')}</p>
          <h2 class="statement text-3xl sm:text-4xl md:text-5xl">{text('博客与选购指南。','Guides for Your Next Order')}</h2>
        </div>
        <a href={`${base}/blog/`} class="group inline-flex items-center gap-1.5 text-ocean font-semibold">{text('更多文章','More guides')} <span class="transition-transform group-hover:translate-x-1">→</span></a>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {posts.map((post, i) => (
          <a href={`${base}/blog/${post.data.slug || post.id}/`} class={`reveal reveal-d${i + 1} card-hover group bg-white rounded-2xl overflow-hidden border border-line`}>
            {post.data.cover && (
              <div class="sheen aspect-[16/9] overflow-hidden bg-sand">
                <BlogImage src={post.data.cover} alt={post.data.coverAlt || post.data.title} width="800" height="450" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="p-5">
              <time class="text-xs text-ink-muted">{post.data.date.toISOString().slice(0, 10)}</time>
              <h3 class="font-display font-bold text-ink mt-1 leading-snug group-hover:text-ocean transition-colors line-clamp-2">{post.data.title}</h3>
              <p class="text-ink-muted text-sm mt-2 line-clamp-2 leading-relaxed">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ FAQ (GEO) ============ -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="reveal text-center mb-10">
      <p class="eyebrow eyebrow-center justify-center mb-4">{text('常见问题','FAQ')}</p>
      <h2 class="statement text-3xl sm:text-4xl">{text('采购前你可能想了解。','Questions Before You Source')}</h2>
    </div>
    <div class="space-y-3">
      {home.faq.map((f) => (
        <details class="reveal group bg-white rounded-xl border border-line px-5 py-4 [&_summary]:cursor-pointer transition-colors duration-300 hover:border-steel-light open:border-steel-light open:shadow-[var(--shadow-soft)]">
          <summary class="flex items-center justify-between gap-4 font-semibold text-ink list-none">
            {f.q}
            <span class="shrink-0 w-7 h-7 grid place-items-center rounded-full bg-steel-50 text-orange transition-transform duration-300 group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="text-ink-muted text-sm mt-3 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20">
    <div class="reveal brand-hero rounded-3xl px-6 sm:px-12 py-16 text-center text-white ring-1 ring-white/10">
      <p class="eyebrow eyebrow-amber eyebrow-center justify-center mb-4">{text('开启合作','START YOUR ENQUIRY')}</p>
      <h2 class="font-display font-extrabold text-3xl md:text-4xl max-w-2xl mx-auto">{home.ctaBand.title}</h2>
      <p class="mt-4 text-white/75 max-w-xl mx-auto">{home.ctaBand.subtitle}</p>
      <a href={en?`${base}/contact/`:waLink} target={en?undefined:'_blank'} rel={en?undefined:'noopener'} data-wa={en?undefined:true} data-wa-product="cta_band" class="btn btn-primary mt-8 px-8 py-4 text-base">{home.ctaBand.button}</a>
    </div>
  </section>

  <!-- 英雄区鼠标光晕（纯原生 JS；触屏 / 降低动态时自动不启用） -->
  <script is:inline>
    (function () {
      var host = document.getElementById('hero-glow-host');
      var layer = document.getElementById('hero-glow');
      if (!host || !layer) return;
      var fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!fine || reduce) return;

      var glow = document.createElement('span');
      glow.style.width = '260px';
      glow.style.height = '260px';
      glow.style.background = 'radial-gradient(circle, rgba(244,169,60,0.18) 0%, rgba(111,183,199,0.08) 38%, rgba(111,183,199,0) 72%)';
      layer.appendChild(glow);

      var tx = 0, ty = 0, raf = 0;
      function render() {
        glow.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0) translate(-50%,-50%)';
        raf = 0;
      }
      function move(e) {
        var r = host.getBoundingClientRect();
        tx = e.clientX - r.left;
        ty = e.clientY - r.top;
        layer.classList.add('is-active');
        if (!raf) raf = requestAnimationFrame(render);
      }
      function leave() {
        layer.classList.remove('is-active');
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      }
      host.addEventListener('pointermove', move, { passive: true });
      host.addEventListener('pointerleave', leave);
    })();
  </script>

</BaseLayout>
