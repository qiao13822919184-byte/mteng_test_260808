---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { isPublished, absolute , safeJson} from '../../lib/publishing';
import { getCollection, render } from 'astro:content';
import categoriesData from '../../data/categories.json';
const categories = categoriesData.categories;
import site from '../../data/site.json';

export async function getStaticPaths() {
  const products = await getCollection('products', isPublished);
  return products.map((p) => ({
    params: { id: p.id },
    props: {
      product: p,
      related: products
        .filter((x) => x.id !== p.id && x.data.category === p.data.category)
        .slice(0, 3),
    },
  }));
}

const { product, related } = Astro.props;
const d = product.data;
const { Content } = await render(product);

const cat = categories.find((c) => c.slug === d.category);
const images = d.images && d.images.length ? d.images : [];
const mainImg = images[0] || 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?q=80&w=1200&auto=format&fit=crop';

// 规格表行
const specRows = [
  d.material && { label: '材质', value: d.material },
  d.finish && { label: '工艺', value: d.finish },
  d.moq && { label: '起订量 (MOQ)', value: d.moq },
  d.leadTime && { label: '交期', value: d.leadTime },
  cat && { label: '分类', value: cat.name },
  ...(d.specs || []),
].filter(Boolean);

const waText = encodeURIComponent(`您好，我想咨询【${d.title}】的报价与详情。`);
const waLink = `https://wa.me/${site.contact.whatsappDigits}?text=${waText}`;
const emailLink = `mailto:${site.contact.email}?subject=${encodeURIComponent('产品询价：' + d.title)}`;

// 结构化数据
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: d.title,
  image: (images.length ? images : [mainImg]).map(absolute),
  description: d.summary,
  category: cat ? cat.name : undefined,
  brand: { '@type': 'Brand', name: site.brand },
  manufacturer: { '@id': absolute('/#organization') },
  material: d.material,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '产品中心', item: new URL('/products', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: Astro.url.href },
  ],
};
---
<BaseLayout title={d.title} description={d.summary} image={mainImg}>
  <script type="application/ld+json" slot="head" set:html={safeJson(productSchema)} />
  <script type="application/ld+json" slot="head" set:html={safeJson(breadcrumbSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-ink-muted mb-8">
      <a href="/" class="hover:text-ocean">首页</a> <span class="mx-1">/</span>
      <a href="/products" class="hover:text-ocean">产品中心</a> <span class="mx-1">/</span>
      <span class="text-ink">{d.title}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14">
      <!-- Gallery -->
      <div class="reveal">
        <div class="sheen group aspect-square rounded-3xl overflow-hidden bg-white border border-line">
          <img id="main-image" src={mainImg} alt={d.title} class="w-full h-full object-contain p-2 sm:p-4 transition-opacity duration-300" />
        </div>
        {images.length > 1 && (
          <div class="flex gap-3 mt-4">
            {images.map((img) => (
              <button class="thumb-btn w-20 h-20 rounded-xl overflow-hidden border-2 border-transparent bg-white focus:border-ocean hover:opacity-80 transition" data-image={img}>
                <img src={img} alt="" class="w-full h-full object-contain p-1 pointer-events-none" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="reveal reveal-d1 flex flex-col">
        {cat && <span class="eyebrow">{cat.name}</span>}
        <h1 class="font-display font-extrabold text-3xl md:text-4xl text-ink mt-2 leading-tight">{d.title}</h1>
        <p class="text-ink-muted mt-4 text-lg leading-relaxed">{d.summary}</p>

        <!-- Spec table -->
        {specRows.length > 0 && (
          <dl class="mt-7 rounded-2xl border border-line overflow-hidden divide-y divide-line shadow-[var(--shadow-soft)]">
            {specRows.map((row) => (
              <div class="flex bg-white transition-colors duration-200 hover:bg-steel-50/50">
                <dt class="w-32 sm:w-40 shrink-0 bg-sand/60 px-4 py-3 text-sm font-semibold text-ink-soft">{row.label}</dt>
                <dd class="px-4 py-3 text-sm text-ink">{row.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <!-- Quote CTA -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product={d.title} class="btn btn-primary flex-1 py-4 text-base">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            WhatsApp 获取报价
          </a>
          <a href={emailLink} class="btn btn-ghost flex-1 py-4 text-base">邮件询价</a>
        </div>
        <p class="text-sm text-ink-muted mt-4">支持 OEM/ODM 定制 · 来图来样 · 批量出口 · {site.contact.businessHours}</p>
      </div>
    </div>

    <!-- Rich description -->
    <div class="reveal mt-16 grid lg:grid-cols-[1fr_320px] gap-12">
      <article class="prose prose-lg max-w-none">
        <h2>产品介绍</h2>
        <Content />
      </article>
      <aside class="reveal reveal-d1 lg:sticky lg:top-24 self-start">
        <div class="brand-hero text-white rounded-2xl p-6">
          <h3 class="font-display font-bold text-lg">需要批量报价？</h3>
          <p class="text-white/75 text-sm mt-2 leading-relaxed">告诉我们数量与定制需求，获取对应的报价方案。</p>
          <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product={`aside_${d.title}`} class="btn btn-primary w-full mt-5 py-3">立即询价</a>
          <div class="mt-4 pt-4 border-t border-white/15 text-sm text-white/70 space-y-1.5">
            <p>✉ {site.contact.email}</p>
            <p> {site.contact.whatsappDisplay}</p>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <div class="reveal mt-20">
        <p class="eyebrow">同系列推荐</p>
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink mt-2 mb-6">相关产品</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    )}
  </div>

  <script is:inline>
    (function () {
      const main = document.getElementById('main-image');
      document.querySelectorAll('.thumb-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const src = btn.getAttribute('data-image');
          if (main && src) {
            main.style.opacity = '0';
            setTimeout(function () { main.src = src; main.style.opacity = '1'; }, 150);
          }
        });
      });
    })();
  </script>
</BaseLayout>
