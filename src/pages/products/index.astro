---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import categoriesData from '../../data/categories.json';
const categories = categoriesData.categories;
import site from '../../data/site.json';
import pages from '../../data/pages.json';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const waText = encodeURIComponent('您好，我想批量采购裕明兴的不锈钢餐厨具，请提供报价。');
const waLink = `https://wa.me/${site.contact.whatsappDigits}?text=${waText}`;
---
<BaseLayout
  title={pages.products.seoTitle}
  description={pages.products.seoDescription}
>
  <PageHero
    breadcrumb={pages.products.breadcrumb}
    eyebrow={pages.products.eyebrow}
    title={pages.products.title}
    description={pages.products.description}
    image={pages.products.heroImage}
    imageAlt={pages.products.heroImageAlt}
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <!-- Filter pills -->
    <div class="reveal flex flex-wrap gap-2.5 mb-8">
      <button class="pill" data-filter="all">全部</button>
      {categories.map((c) => (
        <button class="pill" data-filter={c.slug}>{c.name}</button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="product-grid">
      {products.map((product) => (
        <div class="product-item" data-cat={product.data.category}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <p id="empty-state" class="hidden text-center text-ink-muted py-16">该分类暂无产品，欢迎 WhatsApp 咨询定制。</p>

    <!-- Inline quote CTA -->
    <div class="reveal glass-light card-hover mt-12 rounded-2xl p-8 sm:p-10 text-center">
      <p class="eyebrow eyebrow-center justify-center mb-3">来图来样</p>
      <h2 class="font-display font-bold text-2xl text-ink">没有找到合适的款式？</h2>
      <p class="text-ink-muted mt-2">我们支持来图来样定制，告诉我们你的需求即可获取报价。</p>
      <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="products_cta" class="btn btn-primary mt-6 px-7 py-3.5">WhatsApp 定制咨询</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(location.search);
      const pills = Array.from(document.querySelectorAll('[data-filter]'));
      const items = Array.from(document.querySelectorAll('.product-item'));
      const empty = document.getElementById('empty-state');

      function apply(cat, forceReveal) {
        let visible = 0;
        items.forEach((it) => {
          const show = cat === 'all' || it.dataset.cat === cat;
          it.style.display = show ? '' : 'none';
          if (show) {
            visible++;
            // 用户筛选后，确保被显示出来的卡片不会停留在 .reveal 的初始隐藏态
            if (forceReveal) {
              const r = it.querySelector('.reveal');
              if (r) r.classList.add('is-visible');
            }
          }
        });
        pills.forEach((p) => p.classList.toggle('pill-active', p.dataset.filter === cat));
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      }

      pills.forEach((p) => {
        p.addEventListener('click', function () {
          const cat = p.dataset.filter;
          history.replaceState(null, '', cat === 'all' ? location.pathname : '?cat=' + cat);
          apply(cat, true);
        });
      });

      // 初次加载交给 IntersectionObserver 做渐入；筛选点击时强制显形
      apply(params.get('cat') || 'all', false);
    })();
  </script>
</BaseLayout>
