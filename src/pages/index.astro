---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteelShader from '../components/ui/SteelShader.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import home from '../data/home.json';
import categoriesData from '../data/categories.json';
const categories = categoriesData.categories;

const waText = encodeURIComponent('您好，我想咨询裕明兴的不锈钢餐厨具产品与报价。');
const waLink = `https://wa.me/${site.contact.whatsappDigits}?text=${waText}`;

const allProducts = await getCollection('products');
const sorted = allProducts.sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter((p) => p.data.featured).slice(0, 4);
const featuredProducts = featured.length ? featured : sorted.slice(0, 4);

const posts = (await getCollection('blog'))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: home.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const icons = {
  factory: '<path d="M3 21V9l6 4V9l6 4V5l6 4v12z"/><path d="M9 21v-4M15 21v-4"/>',
  shield: '<path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
  pencil: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/>',
};

// 工艺/数据卡（呼应 Nyra data cards），取自真实参数
const specs = [
  { k: '材质', v: '201 / 304 / 410 / 430', note: '按产品用途与目标市场匹配材质', motif: 'gauge' },
  { k: '工艺', v: '镜面 · 拉丝 · 激光', note: '自有抛光 / 冲压 / 激光打标产线', motif: 'eq' },
  { k: '出口', v: '60+', note: '远销北美 · 欧洲 · 澳洲 · 中东 · 东南亚', motif: 'dots' },
];
---
<BaseLayout
  description={site.seo.defaultDescription}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section id="hero-glow-host" class="brand-hero text-white relative overflow-hidden">
    <!-- 真·WebGL shader 岛屿（受控背景层，client:only 懒挂载；底层 brand-hero CSS 渐变为 SSR 兜底，底部蒙版淡出收边） -->
    <div
      class="shader-fade absolute inset-0 z-0 [mask-image:linear-gradient(to_bottom,#000_72%,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,#000_72%,transparent)]"
      aria-hidden="true"
    >
      <SteelShader />
    </div>
    <!-- 暗场蒙版：顶部（导航）+ 左侧（标题区）压暗，确保亮色流光上文字可读 -->
    <div
      class="absolute inset-0 z-[1] pointer-events-none"
      aria-hidden="true"
      style="background:linear-gradient(to bottom, rgba(5,11,20,0.5), rgba(5,11,20,0) 22%), linear-gradient(100deg, rgba(5,11,20,0.62) 0%, rgba(5,11,20,0.22) 42%, rgba(5,11,20,0) 70%);"
    ></div>
    <!-- 鼠标光晕 + 延迟拖尾层（dots 由脚本注入；位于流光之上、文字之下） -->
    <div id="hero-glow" class="hero-glow" aria-hidden="true"></div>

    <!-- 右上角脉冲光环 + 环绕文字（呼应参考图，低调点缀） -->
    <div class="hidden lg:grid place-items-center absolute top-10 right-8 xl:right-16 w-24 h-24 z-10" aria-hidden="true">
      <span class="accent-ring w-14 h-14 grid place-items-center bg-white/[0.06] text-white/90">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3v7a2 2 0 0 0 4 0V3M8 11v10M16 3c-1.5 0-2.5 1.8-2.5 4.5S14.5 12 16 12v9" />
        </svg>
      </span>
      <svg class="spin-slow absolute inset-0 w-full h-full" viewBox="0 0 100 100">
        <defs><path id="ymx-ring" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" /></defs>
        <text class="fill-white/45" style="font-size:7px;letter-spacing:1.6px;font-weight:600;">
          <textPath href="#ymx-ring" startOffset="0%">批发 · 代工 · 430 · 304 · 410 · 全球出口经验 · </textPath>
        </text>
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-24 md:pt-28 md:pb-32 relative z-10">
      <p class="animate-rise glass inline-flex items-center gap-2 text-sm font-medium text-white/90 rounded-full px-4 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber shadow-[0_0_10px_2px_rgba(244,169,60,0.6)]"></span>{home.hero.eyebrow}
      </p>
      <h1 class="animate-rise steel-text font-display font-extrabold text-4xl sm:text-5xl md:text-6xl leading-[1.06] max-w-4xl">
        {home.hero.title}
      </h1>
      <p class="animate-rise mt-6 text-lg text-white/75 max-w-2xl leading-relaxed">
        {home.hero.subtitle}
      </p>
      <div class="animate-rise mt-9 flex flex-wrap gap-4">
        <a href="/products" class="btn btn-primary px-7 py-3.5 text-base">
          {home.hero.primaryCta}
        </a>
        <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="hero" class="btn btn-outline px-7 py-3.5 text-base">{home.hero.secondaryCta}</a>
      </div>

      <!-- Stat strip -->
      <div class="mt-16 glass relative grid grid-cols-2 sm:grid-cols-4 rounded-2xl overflow-hidden divide-x divide-y sm:divide-y-0 divide-white/10">
        <div class="pointer-events-none absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-steel-light/55 to-transparent"></div>
        {site.highlights.map((h) => (
          <div class="group px-5 py-6 text-center sm:text-left transition-colors duration-300 hover:bg-white/[0.04]">
            <div class="font-display font-extrabold text-2xl md:text-3xl brand-gradient-text">{h.value}</div>
            <div class="text-white/65 text-sm mt-1">{h.label}</div>
          </div>
        ))}
      </div>

      <!-- Feature ticker（呼应 Nyra 底部小字带） -->
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-white/55 text-xs tracking-wide">
        <span>批发</span><span class="text-white/25">····</span>
        <span>代工</span><span class="text-white/25">····</span>
        <span>201 / 304 / 410 / 430</span><span class="text-white/25">····</span>
        <span>全球出口经验</span>
      </div>
    </div>
  </section>

  <!-- ============ 克制陈述（Nyra 招牌大字） ============ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
    <p class="reveal eyebrow eyebrow-center justify-center mb-6">源头制造 · 出口品质</p>
    <p class="reveal reveal-d1 statement text-3xl sm:text-4xl md:text-[2.9rem] md:leading-[1.18]">
      从一把餐叉，到一整套厨具 —— 每一件都以出口标准打造，<br class="hidden md:block" />
      融入日常餐桌，<span class="brand-gradient-text">而不喧哗</span>。
    </p>
  </section>

  <!-- ============ 产品系列（Tab 切换展示） ============ -->
  <section class="bg-sand/50 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">产品系列</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-5xl">无论成套餐具，还是厨具组合，都能找到适合目标市场的产品方案。</h2>
      </div>

      <!-- Tabs -->
      <div class="reveal reveal-d1 mt-9 flex flex-wrap gap-2" role="tablist" aria-label="产品系列">
        {categories.map((c, i) => (
          <button class={`tab ${i === 0 ? 'tab-active' : ''}`} data-tab={c.slug} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{c.name}</button>
        ))}
      </div>

      <!-- Panels -->
      <div class="mt-10">
        {categories.map((c, i) => (
          <div data-panel={c.slug} class={`${i === 0 ? '' : 'hidden'} grid lg:grid-cols-2 gap-8 lg:gap-14 items-center`}>
            <div class="sheen group rounded-3xl overflow-hidden border border-line ring-1 ring-line aspect-[4/3] order-last lg:order-first">
              <img src={c.image} alt={c.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div>
              <p class="eyebrow mb-4">{c.nameEn}</p>
              <h3 class="font-display font-bold text-2xl md:text-3xl text-ink leading-snug">{c.name}</h3>
              <p class="text-ink-soft leading-relaxed mt-4 max-w-md">{c.summary}</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href={`/products?cat=${c.slug}`} class="btn btn-ghost px-6 py-3">查看该系列 →</a>
                <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product={`series_${c.slug}`} class="btn btn-primary px-6 py-3">WhatsApp 询价</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ VALUE PROPS（编辑风四列） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="reveal max-w-3xl mb-12">
      <p class="eyebrow mb-4">我们的优势</p>
      <h2 class="statement text-3xl sm:text-4xl md:text-5xl">一家把控全流程的源头工厂。</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 border-t border-line">
      {home.valueProps.map((p, i) => (
        <div class={`reveal reveal-d${i + 1} group py-8 sm:px-6 border-b sm:border-b-0 sm:border-r border-line last:border-r-0 sm:[&:nth-child(2)]:border-r-0 lg:[&:nth-child(2)]:border-r`}>
          <span class="w-12 h-12 rounded-xl bg-steel-50 text-ocean grid place-items-center mb-5 ring-1 ring-steel-light/30 transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
          </span>
          <h3 class="font-display font-bold text-ink text-lg">{p.title}</h3>
          <p class="text-ink-muted text-sm mt-2 leading-relaxed max-w-xs">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ FEATURED PRODUCTS ============ -->
  <section class="bg-sand/50 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal flex flex-wrap items-end justify-between gap-4 mb-12">
        <div class="max-w-2xl">
          <p class="eyebrow mb-4">精选产品</p>
          <h2 class="statement text-3xl sm:text-4xl md:text-5xl">从这些热门款式开始了解。</h2>
        </div>
        <a href="/products" class="group inline-flex items-center gap-1.5 text-ocean font-semibold">全部产品 <span class="transition-transform group-hover:translate-x-1">→</span></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- ============ 工艺照片 + 说明（Nyra photo + caption） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="reveal rounded-3xl overflow-hidden aspect-[4/3] ring-1 ring-line border border-line">
        <div class="sheen group w-full h-full">
          <img src={home.whyUs.image} alt={home.whyUs.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
      </div>
      <div class="reveal reveal-d1">
        <p class="eyebrow mb-4">{home.whyUs.subtitle}</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-[2.6rem] md:leading-[1.18]">{home.whyUs.title}</h2>
        <ul class="mt-8 space-y-4">
          {home.whyUs.points.map((pt) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 w-6 h-6 shrink-0 rounded-full brand-gradient grid place-items-center shadow-[0_4px_12px_-4px_rgba(224,70,26,0.6)]">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg>
              </span>
              <span class="text-ink-soft leading-relaxed">{pt}</span>
            </li>
          ))}
        </ul>
        <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="whyus" class="btn btn-primary mt-9 px-7 py-3.5">立即询价</a>
      </div>
    </div>
  </section>

  <!-- ============ 参数 / 数据卡（Nyra data cards，深色高级感） ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20 sm:pb-28">
    <div class="reveal max-w-3xl mb-12">
      <p class="eyebrow mb-4">为什么是裕明兴</p>
      <h2 class="statement text-3xl sm:text-4xl md:text-5xl">材质、工艺、产能与出口经验，<br class="hidden sm:block" />集于一家工厂。</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {specs.map((s, i) => (
        <div class={`reveal reveal-d${i + 1} spec-card card-hover p-7 text-white`}>
          <div class="flex items-center justify-between">
            <span class="eyebrow eyebrow-amber">{s.k}</span>
            {s.motif === 'eq' && (
              <span class="eq-bars" aria-hidden="true">
                <i style="height:40%;animation-delay:0s"></i><i style="height:75%;animation-delay:.15s"></i><i style="height:55%;animation-delay:.3s"></i><i style="height:95%;animation-delay:.45s"></i><i style="height:65%;animation-delay:.6s"></i>
              </span>
            )}
            {s.motif === 'gauge' && (
              <svg width="34" height="34" viewBox="0 0 36 36" aria-hidden="true" class="-rotate-90">
                <circle cx="18" cy="18" r="15" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="3" />
                <circle cx="18" cy="18" r="15" fill="none" stroke="url(#sp-grad)" stroke-width="3" stroke-linecap="round" stroke-dasharray="94.2" stroke-dashoffset="14" />
                <defs><linearGradient id="sp-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6fb7c7"/><stop offset="100%" stop-color="#f4a93c"/></linearGradient></defs>
              </svg>
            )}
            {s.motif === 'dots' && (
              <span class="flex gap-1.5" aria-hidden="true">
                <i class="w-1.5 h-1.5 rounded-full bg-steel-light"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-amber"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-orange"></i>
              </span>
            )}
          </div>
          <div class="font-display font-extrabold text-4xl mt-6 tracking-tight">{s.v}</div>
          <p class="text-white/60 text-sm mt-3 leading-relaxed">{s.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 合作流程（真实序列，编号成立） ============ -->
  <section class="bg-sand/50 border-y border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal max-w-3xl mb-12">
        <p class="eyebrow mb-4">合作流程</p>
        <h2 class="statement text-3xl sm:text-4xl md:text-5xl">从询价到交付，四步搞定。</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {home.process.map((s, i) => (
          <div class={`reveal reveal-d${i + 1} card-hover relative bg-white rounded-2xl border border-line p-6 overflow-hidden`}>
            <span class="font-display font-extrabold text-5xl brand-gradient-text">{s.step}</span>
            <h3 class="font-display font-bold text-ink text-lg mt-3">{s.title}</h3>
            <p class="text-ink-muted text-sm mt-2 leading-relaxed">{s.desc}</p>
            <span class="pointer-events-none absolute -bottom-6 -right-4 font-display font-black text-8xl text-line/40 select-none">{s.step}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LATEST BLOG ============ -->
  {posts.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="reveal flex flex-wrap items-end justify-between gap-4 mb-12">
        <div class="max-w-2xl">
          <p class="eyebrow mb-4">采购知识</p>
          <h2 class="statement text-3xl sm:text-4xl md:text-5xl">博客与选购指南。</h2>
        </div>
        <a href="/blog" class="group inline-flex items-center gap-1.5 text-ocean font-semibold">更多文章 <span class="transition-transform group-hover:translate-x-1">→</span></a>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class={`reveal reveal-d${i + 1} card-hover group bg-white rounded-2xl overflow-hidden border border-line`}>
            {post.data.cover && (
              <div class="sheen aspect-[16/9] overflow-hidden bg-sand">
                <img src={post.data.cover} alt={post.data.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="p-5">
              <time class="text-xs text-ink-muted">{post.data.date.toISOString().slice(0, 10)}</time>
              <h3 class="font-display font-bold text-ink mt-1 leading-snug group-hover:text-ocean transition-colors line-clamp-2">{post.data.title}</h3>
              <p class="text-ink-muted text-sm mt-2 line-clamp-2 leading-relaxed">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ FAQ (GEO) ============ -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <div class="reveal text-center mb-10">
      <p class="eyebrow eyebrow-center justify-center mb-4">常见问题</p>
      <h2 class="statement text-3xl sm:text-4xl">采购前你可能想了解。</h2>
    </div>
    <div class="space-y-3">
      {home.faq.map((f) => (
        <details class="reveal group bg-white rounded-xl border border-line px-5 py-4 [&_summary]:cursor-pointer transition-colors duration-300 hover:border-steel-light open:border-steel-light open:shadow-[var(--shadow-soft)]">
          <summary class="flex items-center justify-between gap-4 font-semibold text-ink list-none">
            {f.q}
            <span class="shrink-0 w-7 h-7 grid place-items-center rounded-full bg-steel-50 text-orange transition-transform duration-300 group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="text-ink-muted text-sm mt-3 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20">
    <div class="reveal brand-hero rounded-3xl px-6 sm:px-12 py-16 text-center text-white ring-1 ring-white/10">
      <p class="eyebrow eyebrow-amber eyebrow-center justify-center mb-4">开启合作</p>
      <h2 class="font-display font-extrabold text-3xl md:text-4xl max-w-2xl mx-auto">{home.ctaBand.title}</h2>
      <p class="mt-4 text-white/75 max-w-xl mx-auto">{home.ctaBand.subtitle}</p>
      <a href={waLink} target="_blank" rel="noopener" data-wa data-wa-product="cta_band" class="btn btn-primary mt-8 px-8 py-4 text-base">{home.ctaBand.button}</a>
    </div>
  </section>

  <!-- 英雄区鼠标光晕（纯原生 JS；触屏 / 降低动态时自动不启用） -->
  <script is:inline>
    (function () {
      var host = document.getElementById('hero-glow-host');
      var layer = document.getElementById('hero-glow');
      if (!host || !layer) return;
      var fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!fine || reduce) return;

      var glow = document.createElement('span');
      glow.style.width = '260px';
      glow.style.height = '260px';
      glow.style.background = 'radial-gradient(circle, rgba(244,169,60,0.18) 0%, rgba(111,183,199,0.08) 38%, rgba(111,183,199,0) 72%)';
      layer.appendChild(glow);

      var tx = 0, ty = 0, raf = 0;
      function render() {
        glow.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0) translate(-50%,-50%)';
        raf = 0;
      }
      function move(e) {
        var r = host.getBoundingClientRect();
        tx = e.clientX - r.left;
        ty = e.clientY - r.top;
        layer.classList.add('is-active');
        if (!raf) raf = requestAnimationFrame(render);
      }
      function leave() {
        layer.classList.remove('is-active');
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      }
      host.addEventListener('pointermove', move, { passive: true });
      host.addEventListener('pointerleave', leave);
    })();
  </script>

  <!-- 产品系列 Tab 切换脚本（纯原生 JS，无依赖） -->
  <script is:inline>
    (function () {
      const tabs = Array.from(document.querySelectorAll('[data-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-panel]'));
      function show(slug) {
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== slug));
        tabs.forEach((t) => {
          const on = t.dataset.tab === slug;
          t.classList.toggle('tab-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      }
      tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab)));
    })();
  </script>
</BaseLayout>
