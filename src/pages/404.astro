<BaseLayout title="Page not found" noindex={true} locale="en">
  <section class="max-w-3xl mx-auto px-4 py-24"><p class="eyebrow">404</p><h1 class="statement text-4xl mt-4">Page not found</h1><p class="text-ink-muted mt-6">This address is no longer available. Browse the catalogue or contact Yumingxing for help.</p><div class="flex flex-wrap gap-3 mt-8"><a href="/en/" class="btn btn-primary px-6 py-3">English homepage</a><a href="/" class="btn btn-ghost px-6 py-3" lang="zh-CN">中文首页</a></div></section>
</BaseLayout>
