---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';
import pages from '../data/pages.json';

const c = site.contact;
const waLinkPlain = `https://wa.me/${c.whatsappDigits}`;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent('广东省揭阳市榕城区')}&output=embed`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.companyName,
  alternateName: site.brand,
  url: site.siteUrl,
  email: c.email,
  telephone: c.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.addressLine,
    addressLocality: '揭阳市',
    addressRegion: '广东省',
    addressCountry: 'CN',
  },
};

const methods = [
  { label: 'WhatsApp', value: c.whatsappDisplay, href: waLinkPlain, note: '点击直接对话', wa: true },
  { label: '邮箱 Email', value: c.email, href: `mailto:${c.email}`, note: '商务合作与询价', wa: false },
  { label: '电话 Phone', value: c.phoneDisplay, href: `tel:${c.phoneDisplay.replace(/[^\d+]/g, '')}`, note: '工作时间内接听', wa: false },
  { label: '微信 WeChat', value: c.wechat, href: null, note: '添加时请备注采购需求', wa: false },
  { label: '地址 Address', value: c.addressLine, href: null, note: site.companyName, wa: false },
  { label: '营业时间', value: c.businessHours, href: null, note: '欢迎随时留言', wa: false },
];
---
<BaseLayout
  title="联系我们"
  description={`联系${site.companyName}：WhatsApp ${c.whatsappDisplay}，邮箱 ${c.email}，地址 ${c.addressLine}。欢迎询价与定制咨询。`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusinessSchema)} />

  <PageHero
    breadcrumb={pages.contact.breadcrumb}
    eyebrow={pages.contact.eyebrow}
    title={pages.contact.title}
    description={pages.contact.description}
    image={pages.contact.heroImage}
    imageAlt={pages.contact.heroImageAlt}
  />

  <!-- Methods -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-12 relative z-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {methods.map((m, i) => (
        <div class={`reveal reveal-d${i + 1} card-hover bg-white rounded-2xl border border-line p-6 shadow-[var(--shadow-soft)]`}>
          <p class="eyebrow">{m.label}</p>
          {m.href ? (
            <a
              href={m.href}
              target={m.wa ? '_blank' : undefined}
              rel={m.wa ? 'noopener' : undefined}
              {...(m.wa ? { 'data-wa': true, 'data-wa-product': 'contact_method' } : {})}
              class="block font-display font-bold text-ink text-lg mt-2 break-words hover:text-ocean transition-colors"
            >
              {m.value}
            </a>
          ) : (
            <p class="font-display font-bold text-ink text-lg mt-2 break-words">{m.value}</p>
          )}
          <p class="text-ink-muted text-sm mt-1">{m.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Form + Map -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 grid lg:grid-cols-2 gap-10">
    <!-- Inquiry form (no backend → 组装 WhatsApp 消息) -->
    <div class="reveal">
      <p class="eyebrow mb-2">在线询价</p>
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink">发送询价</h2>
      <p class="text-ink-muted mt-2">填写下方信息，点击发送会自动通过 WhatsApp 把内容发给我们。</p>

      <form id="inquiry-form" class="mt-7 space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink-soft mb-1.5">姓名 *</label>
            <input name="name" required class="w-full rounded-xl border border-line bg-white px-4 py-3 focus:outline-none focus:border-steel" placeholder="您的称呼" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink-soft mb-1.5">公司</label>
            <input name="company" class="w-full rounded-xl border border-line bg-white px-4 py-3 focus:outline-none focus:border-steel" placeholder="公司名称（选填）" />
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink-soft mb-1.5">感兴趣的产品</label>
            <input name="product" class="w-full rounded-xl border border-line bg-white px-4 py-3 focus:outline-none focus:border-steel" placeholder="如：24件套餐具" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink-soft mb-1.5">预计数量</label>
            <input name="qty" class="w-full rounded-xl border border-line bg-white px-4 py-3 focus:outline-none focus:border-steel" placeholder="如：1000 套" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink-soft mb-1.5">留言</label>
          <textarea name="message" rows="4" class="w-full rounded-xl border border-line bg-white px-4 py-3 focus:outline-none focus:border-steel" placeholder="定制需求、目的港、其他说明…"></textarea>
        </div>
        <button type="submit" data-wa data-wa-product="contact_form" class="btn btn-primary w-full py-4 text-base">
          通过 WhatsApp 发送询价
        </button>
        <p class="text-xs text-ink-muted text-center">提交即通过 WhatsApp 打开对话，不会泄露给第三方。</p>
      </form>
    </div>

    <!-- Map + quick contact -->
    <div class="reveal reveal-d1 flex flex-col gap-6">
      <div class="rounded-2xl overflow-hidden border border-line h-72 lg:h-80">
        <iframe src={mapEmbed} title="工厂位置" width="100%" height="100%" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="brand-hero text-white rounded-2xl p-7 ring-1 ring-white/10">
        <p class="eyebrow eyebrow-amber mb-3">即时沟通</p>
        <h3 class="font-display font-bold text-xl">更快联系我们</h3>
        <p class="text-white/75 text-sm mt-2 leading-relaxed">WhatsApp 是最快的方式，营业时间内通常几分钟内回复。</p>
        <a href={waLinkPlain} target="_blank" rel="noopener" data-wa data-wa-product="contact_quick" class="btn btn-primary w-full mt-5 py-3.5">直接发起 WhatsApp 对话</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ waDigits: c.whatsappDigits }}>
    (function () {
      const form = document.getElementById('inquiry-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const f = new FormData(form);
        const lines = [
          '【网站询价】',
          '姓名：' + (f.get('name') || ''),
          f.get('company') ? '公司：' + f.get('company') : '',
          f.get('product') ? '产品：' + f.get('product') : '',
          f.get('qty') ? '数量：' + f.get('qty') : '',
          f.get('message') ? '留言：' + f.get('message') : '',
        ].filter(Boolean);
        const url = 'https://wa.me/' + waDigits + '?text=' + encodeURIComponent(lines.join('\n'));
        window.open(url, '_blank');
      });
    })();
  </script>
</BaseLayout>
