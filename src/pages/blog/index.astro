---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import pages from '../../data/pages.json';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const [featured, ...rest] = posts;
---
<BaseLayout
  title={pages.blog.seoTitle}
  description={pages.blog.seoDescription}
>
  <PageHero
    breadcrumb={pages.blog.breadcrumb}
    eyebrow={pages.blog.eyebrow}
    title={pages.blog.title}
    description={pages.blog.description}
    image={pages.blog.heroImage}
    imageAlt={pages.blog.heroImageAlt}
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    {posts.length === 0 && (
      <p class="text-center text-ink-muted py-20">文章即将上线，敬请期待。</p>
    )}

    {featured && (
      <a href={`/blog/${featured.id}`} class="reveal card-hover group grid md:grid-cols-2 gap-6 bg-white rounded-3xl border border-line overflow-hidden mb-10">
        {featured.data.cover && (
          <div class="sheen aspect-[16/10] md:aspect-auto overflow-hidden bg-sand">
            <img src={featured.data.cover} alt={featured.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
        )}
        <div class="p-7 flex flex-col justify-center">
          <p class="eyebrow">置顶 · 最新</p>
          <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink mt-2 leading-snug group-hover:text-ocean transition-colors">{featured.data.title}</h2>
          <p class="text-ink-muted mt-3 leading-relaxed line-clamp-3">{featured.data.description}</p>
          <div class="mt-5 flex items-center gap-3 text-sm text-ink-muted">
            <time>{featured.data.date.toISOString().slice(0, 10)}</time>
            <span>·</span>
            <span>{featured.data.author}</span>
          </div>
        </div>
      </a>
    )}

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {rest.map((post, i) => (
        <a href={`/blog/${post.id}`} class={`reveal reveal-d${i + 1} card-hover group bg-white rounded-2xl overflow-hidden border border-line flex flex-col`}>
          {post.data.cover && (
            <div class="sheen aspect-[16/9] overflow-hidden bg-sand">
              <img src={post.data.cover} alt={post.data.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          )}
          <div class="p-5 flex flex-col flex-grow">
            <time class="text-xs text-ink-muted">{post.data.date.toISOString().slice(0, 10)}</time>
            <h3 class="font-display font-bold text-ink mt-1 leading-snug group-hover:text-ocean transition-colors line-clamp-2">{post.data.title}</h3>
            <p class="text-ink-muted text-sm mt-2 line-clamp-3 leading-relaxed flex-grow">{post.data.description}</p>
            {post.data.tags?.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {post.data.tags.slice(0, 3).map((t) => (
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-steel-50 text-ocean font-medium">{t}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
