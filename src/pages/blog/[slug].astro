---
import BlogView from '../../views/en/blog/[slug].astro';
import StaticRedirect from '../../components/StaticRedirect.astro';
import {getCollection} from 'astro:content';
import {isPublished,entrySlug} from '../../lib/publishing';
export async function getStaticPaths(){
  const [posts,chinese]=await Promise.all([getCollection('blogEn',isPublished),getCollection('blog',isPublished)]);
  const slugs=new Set(posts.map(entrySlug));
  return [...posts.map(post=>({params:{slug:entrySlug(post)},props:{post}})),...chinese.filter(post=>!slugs.has(entrySlug(post))).map(post=>({params:{slug:entrySlug(post)},props:{redirectTo:`/cn/blog/${entrySlug(post)}/`}}))];
}
const {post,redirectTo}=Astro.props;
---
{redirectTo ? <StaticRedirect to={redirectTo} /> : <BlogView post={post} />}
